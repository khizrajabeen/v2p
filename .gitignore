# Reference data — 3.8 GB, downloaded by scripts/00_fetch_references.sh.
# Never commit these: GitHub's per-file limit is 100 MB and the genome alone
# is 3.1 GB. The fetch script pins the release and asserts the build, so the
# references stay reproducible without being stored.
ref/

# Input data. These are symlinks to the high-confidence variant package,
# which lives outside this repo and is not ours to redistribute.
data/*
!data/README.txt

# Pipeline output. All of it is derived from src/ plus ref/ plus data/, and
# all of it is large.
results/
benchmark/
HCC1395_variant_proteins/
release/
v2p_output/

# Provenance logs. Written on every run, one pair of files per stage.
logs/

# Test fixtures are generated by tests/make_fixture.py on each run, so the
# synthetic genome is reproducible rather than stored.
tests/fixtures/

# Editor and interpreter litter
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# Anchored to the repo root on purpose. A bare `build/` also matches
# src/v2p/build/, which is source, not a build artefact - it silently
# dropped the three variant builders from the tracked set.
/build/
/dist/
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/
*.swp

# Superseded copies kept during development. Not history — git is history.
*.bak
*.orig
*.rej

# Coverage and tooling caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# M2 reproducibility harness output
.repro/

# Benchmark run output (the truth data under benchmarks/truth/ IS tracked)
benchmarks/results/

# pypgatk writes these into the working directory
ensembl_translation-*.log
